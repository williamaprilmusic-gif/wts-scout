# WTS Scout mode
# Production is the fail-safe default. Preview mode requires BOTH values below
# and should be configured only for Vercel Preview deployments.
# VITE_WTS_SCOUT_MODE=preview
# VITE_WTS_VERCEL_ENV=preview
# Local-only demo mode (Vite development server):
# VITE_WTS_SCOUT_MODE=demo

# Database: Neon Postgres connected through Vercel Marketplace
DATABASE_URL=postgres://...

# Blob: Vercel Blob connected to the project
# Current Blob stores use Vercel OIDC on Vercel; BLOB_STORE_ID is supplied when the store is connected.
BLOB_STORE_ID=...
# Legacy/static-token Blob stores only:
BLOB_READ_WRITE_TOKEN=...

# AI: Vercel AI Gateway
# On Vercel, OIDC can be used automatically; locally or when OIDC is unavailable, use this key.
AI_GATEWAY_API_KEY=...
WTS_SCOUT_MODEL=openai/gpt-5.4
