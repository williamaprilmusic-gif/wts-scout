# Database: Neon Postgres connected through Vercel Marketplace
DATABASE_URL=postgres://...

# Blob: Vercel Blob connected to the project
# New Vercel Blob stores may use OIDC automatically. Older stores can use this token.
BLOB_READ_WRITE_TOKEN=...

# AI: Vercel AI Gateway (API key or Vercel OIDC)
AI_GATEWAY_API_KEY=...
WTS_SCOUT_MODEL=openai/gpt-5.4
